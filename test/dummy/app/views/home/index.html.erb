<% dummy_page_nav(title: "Site index", back_url: root_path) %>

<div class="flex w-full flex-col gap-6">
  <%= render FlatPack::PageTitle::Component.new(
    title: "Site index",
    subtitle: "Enter a public website. The finder reads its published sitemap files.",
    variant: :h1
  ) %>

  <%= form_with url: root_path, method: :get do %>
    <div class="flex flex-col gap-4">
      <%= render FlatPack::SearchInput::Component.new(
        name: "url",
        label: "Site URL",
        value: params[:url]
      ) %>
      <%= render FlatPack::Button::Component.new(
        text: "Find site index",
        style: :primary,
        type: :submit
      ) %>
    </div>
  <% end %>

  <% if @failure %>
    <%= render FlatPack::Alert::Component.new(style: :danger, description: @failure.message) %>
  <% end %>

  <% if @result %>
    <%= render FlatPack::Card::Component.new(style: :outlined) do |card| %>
      <% card.body do %>
        <dl class="grid gap-2 text-sm">
          <div><dt class="font-semibold">Supplied URL</dt><dd><%= @supplied_url %></dd></div>
          <div><dt class="font-semibold">Resolved site URL</dt><dd><%= @result.site_url %></dd></div>
          <div><dt class="font-semibold">Status</dt><dd><%= site_index_status_label(@result) %></dd></div>
          <div><dt class="font-semibold">Sitemap files</dt><dd><%= @result.sitemaps.size %></dd></div>
          <div><dt class="font-semibold">URLs found</dt><dd><%= @result.url_count %></dd></div>
        </dl>
      <% end %>
    <% end %>

    <% if @result.status == :empty %>
      <%= render FlatPack::Alert::Component.new(
        style: :info,
        description: "No sitemap was found."
      ) %>
    <% end %>

    <% if @result.sitemaps.any? %>
      <%= render FlatPack::PageTitle::Component.new(title: "Sitemap files", variant: :h3) %>
      <%= render FlatPack::Table::Component.new(
        data: @result.sitemaps.map { |sitemap| { url: sitemap.url, type: sitemap.type.to_s } },
        class: "text-sm"
      ) do |table| %>
        <% table.column(title: "Sitemap") { |row| row[:url] } %>
        <% table.column(title: "Type") { |row| row[:type] } %>
      <% end %>
    <% end %>

    <% if @result.urls.any? %>
      <% shown = @result.urls.first(@preview_limit) %>
      <%= render FlatPack::PageTitle::Component.new(title: "Discovered URLs", variant: :h3) %>
      <% if @result.url_count > shown.size %>
        <p class="text-sm">Showing <%= shown.size %> of <%= @result.url_count %>.</p>
      <% end %>
      <%= render FlatPack::Table::Component.new(
        data: shown.map { |page| { url: page.url, last_modified_at: page.last_modified_at } },
        class: "text-sm"
      ) do |table| %>
        <% table.column(title: "URL") { |row| row[:url] } %>
        <% table.column(title: "Last modified") { |row| row[:last_modified_at] } %>
      <% end %>
    <% end %>

    <% if @result.errors.any? %>
      <%= render FlatPack::PageTitle::Component.new(title: "Errors", variant: :h3) %>
      <%= render FlatPack::Table::Component.new(
        data: @result.errors.map { |error|
          { code: error.code.to_s, status: error.status, message: error.message, url: error.url }
        },
        class: "text-sm"
      ) do |table| %>
        <% table.column(title: "Code") { |row| row[:code] } %>
        <% table.column(title: "Status") { |row| row[:status] } %>
        <% table.column(title: "Message") { |row| row[:message] } %>
        <% table.column(title: "URL") { |row| row[:url] } %>
      <% end %>
    <% end %>
  <% end %>
</div>
